# Optional development-only preview login. These are ignored in production.
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_SESSION_SECRET=
# Real human video rooms (feature 2). Server-only; GIF partners need none of these.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
