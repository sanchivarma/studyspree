{
  "name": "studyspree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:audio-licences": "node --experimental-strip-types scripts/check-audio-licences.ts",
    "prebuild": "npm run check:audio-licences && npm run check:character-assets",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:test": "supabase test db",
    "check:character-assets": "node scripts/check-character-assets.mjs",
    "test:e2e:supabase": "playwright test -c playwright.supabase.config.ts",
    "maintenance": "node scripts/maintenance.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.23.0",
    "howler": "^2.2.4",
    "livekit-client": "2.20.0",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
