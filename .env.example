NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
# Server-only random secret, at least 32 characters. Save its SHA-256 hash
# in auth_private.login_config as described in docs/supabase-setup.md.
SUPABASE_USERNAME_LOOKUP_SECRET=
# Optional development-only preview login. These are ignored in production.
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_SESSION_SECRET=
# Real human video rooms (feature 2). Server-only; GIF partners need none of these.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Server-only maintenance. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional direct email using an existing Gmail account (no paid API needed).
# Generate a Google App Password; never use your normal account password here.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
INVITATION_FROM=
# Public HTTPS app address recipients can actually open, e.g. your deployment URL.
INVITATION_SITE_URL=
# Alternative to SMTP: optional Resend sending-access key.
RESEND_API_KEY=
# Optional explicit choice: smtp, resend, or mailpit (local Supabase only).
INVITATION_EMAIL_TRANSPORT=
# Without sender credentials, local Supabase captures invitations in Mailpit.
