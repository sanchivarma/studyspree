NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
# Server-only random secret, at least 32 characters. Save its SHA-256 hash
# in auth_private.login_config as described in docs/supabase-setup.md.
